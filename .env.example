# ==============================================================================
# OSTİM Mobile App - Environment Configuration Template
# Copy this file to .env and fill in real values for local development.
# NOTE: .env is gitignored and will never be committed to source control.
# ==============================================================================

# Master key used by the app to decrypt config.enc from GitHub
EXPO_PUBLIC_APP_CONFIG_KEY=CHANGE_THIS_TO_YOUR_PROJECT_PASSPHRASE

# URL of the encrypted remote config file hosted on GitHub
EXPO_PUBLIC_REMOTE_CONFIG_URL=https://raw.githubusercontent.com/username/ostim-app/main/config.enc

# Local Fallback Keys (Optional for offline dev without remote fetch)
EXPO_PUBLIC_OBS_BASE_URL=https://obs.ostimteknik.edu.tr/ProlizMobileAPI_V4/api
EXPO_PUBLIC_OBS_AES_KEY=PLACEHOLDER_KEY
EXPO_PUBLIC_OBS_UNI_CODE=OST
EXPO_PUBLIC_OBS_SECRET=PLACEHOLDER_SECRET
EXPO_PUBLIC_OBS_UNI_TOKEN=PLACEHOLDER_TOKEN

EXPO_PUBLIC_LMS_TOKEN_URL=https://lmsclus.ostimteknik.edu.tr/login/token.php
EXPO_PUBLIC_LMS_SERVICE_URL=https://lmsclus.ostimteknik.edu.tr/webservice/rest/server.php
